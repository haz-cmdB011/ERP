# URL del proyecto Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable/anon del proyecto Supabase (Settings > API > Project API keys)
# Es segura de exponer en el cliente: el acceso real lo controla RLS en Postgres.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta "service_role" (Settings > API > Project API keys).
# NUNCA debe tener el prefijo NEXT_PUBLIC_ ni exponerse al cliente: bypassa
# RLS por completo. Solo se usa en rutas de servidor con guard de admin
# (crear usuarios nuevos vía Supabase Auth Admin API).
SUPABASE_SERVICE_ROLE_KEY=


# --- Seguridad (todas opcionales; ver SEGURIDAD.md) ---

# Dominios de correo que pueden registrarse solos en /registro, separados por comas.
# Vacío = cualquiera puede crear una cuenta (queda pendiente: sin rol no ve datos).
# Ejemplo: REGISTRO_DOMINIOS_PERMITIDOS=mobiliarium.com,gcdi.com.mx
REGISTRO_DOMINIOS_PERMITIDOS=

# URL pública del sitio, sin diagonal final. Si se define, los QR usan esta URL en vez
# de la cabecera Host de la petición. Ejemplo: https://erp-becario.vercel.app
NEXT_PUBLIC_SITE_URL=

# 1 = la política de seguridad de contenido (CSP) solo reporta en la consola del
# navegador y no bloquea. Úsalo solo para diagnosticar si algo legítimo quedara bloqueado.
CSP_SOLO_REPORTE=
